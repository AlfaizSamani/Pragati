# ==========================================
# PAIMANA / PRAGATI Deployment Environment Variables
# ==========================================

# 1. API Service & Ingestion Endpoint
# For local frontend: http://localhost:8000
# For production frontend on Vercel: URL of your deployed Python service (e.g. https://pragati-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Supabase Configuration
# Found in your Supabase project dashboard under Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key (Used ONLY on backend service, NEVER expose to frontend or Vercel client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 3. Role Protection Flags
PAIMANA_PROTECT_INGESTION=true
PAIMANA_PROTECT_INTELLIGENCE=true
PAIMANA_OFFICER_COOKIE=paimana_officer_session

# 4. LLM Configuration (Flexible Provider Gateway)
# LLM_PROVIDER options: 'openai', 'openai_compatible', 'local'
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_provider_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# For private local GGUF mode (optional):
# LLM_PROVIDER=local
# PRAGATI_LLM_MODEL=/path/to/qwen2.5-7b-instruct-q4_k_m.gguf

# 5. CORS Allowed Origins (comma-separated, for backend service)
PRAGATI_ALLOWED_ORIGINS=http://localhost:3000,https://pragati.vercel.app,https://your-domain.vercel.app
